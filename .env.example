PORT=3000
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=sales
DELIVERY_BASE_URL=http://delivery-mock:4000
DELIVERY_TIMEOUT_MS=5000
DELIVERY_MAX_RETRIES=3
DELIVERY_RETRY_BASE_DELAY_MS=200
ORDER_CREATED_QUEUE=order-created-events
ORDER_STATUS_QUEUE=order-status-events
AUTO_CONSUME_STATUS_QUEUE=false

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_WINDOW=60000
RATE_LIMIT_ORDER_CREATE_MAX=10
RATE_LIMIT_ORDER_CREATE_WINDOW=60000
RATE_LIMIT_ORDER_READ_MAX=100
RATE_LIMIT_ORDER_READ_WINDOW=60000
RATE_LIMIT_ORDER_STATUS_MAX=50
RATE_LIMIT_ORDER_STATUS_WINDOW=60000
RATE_LIMIT_STORE_PROVIDER=memory
# When RATE_LIMIT_STORE_PROVIDER=redis
# RATE_LIMIT_REDIS_HOST=127.0.0.1
# RATE_LIMIT_REDIS_PORT=6379
# RATE_LIMIT_REDIS_USERNAME=
# RATE_LIMIT_REDIS_PASSWORD=
# RATE_LIMIT_REDIS_DB=0
# RATE_LIMIT_REDIS_TLS=false
